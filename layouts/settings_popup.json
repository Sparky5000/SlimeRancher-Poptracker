                                                            "h_alignment": "left",
                                                            "item_h_alignment": "center",
                                                            "item_v_alignment": "center",
                                                            "item_height": 64,
                                                            "item_width": 64,
                                                            "rows": [
                                                                [
                                                                    "ObscureLocations",
