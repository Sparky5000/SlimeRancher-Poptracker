{
    "settings_popup": {
        "type": "container",
        "background": "#00000000",
        "content": {
            "type": "dock",
            "dropshadow": true,
            "content": [
                {
                    "type": "dock",
                    "dock": "left",
                    "v_alignment": "stretch",
                    "content": [
                        {
                            "type": "group",
                            "header": "Settings",
                            "header_background": "#3e4b57",
                            "content": [
                                {
                                    "type": "array",
                                    "orientation": "vertical",
                                    "margin": "0,0",
                                    "content": [
                                        {
                                            "type": "array",
                                            "orientation": "horizontal",
                                            "margin": "0,0",
                                            "content": [
                                                {
                                                    "type": "itemgrid",
                                                    "item_margin": "2, 2",
                                                    "h_alignment": "left",
                                                    "item_h_alignment": "center",
                                                    "item_v_alignment": "center",
                                                    "item_height": 64,
                                                    "item_width": 64,
                                                    "rows": [
                                                        [
                                                            "MarketLogic"
                                                        ]
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}